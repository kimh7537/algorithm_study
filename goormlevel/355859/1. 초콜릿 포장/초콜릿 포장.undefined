#include <bits/stdc++.h>
using namespace std;

int a, b, res;
int f, s, t;
vector<int> v;

int main() {
	cin >> a >> b;
	for(int i = 0 ; i < b ; i++){
		cin >> f >> s;
		int temp = f * s;
		v.push_back(temp);
	}

	sort(v.begin(), v.end(), greater<int>());
	t = a;
	for(auto it : v){
		// cout << "it : " << it << "\n";
		t -= it;
		res++;
		// cout << " t : " << t << "\n";
		if(t <= 0) {
			break;
		}
	}

	if(t > 0) res = -1;
	
	cout << res << "\n";
	return 0;
}